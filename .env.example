# GHL Webhook URL - receives lead form submissions (server-side only, never expose to client)
LEAD_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/YOUR_HOOK_ID/webhook-trigger/YOUR_TRIGGER_ID

# GHL Booking Calendar URL - shown on /thank-you page
VITE_GHL_CALENDAR_URL=https://api.leadconnectorhq.com/widget/bookings/YOUR_CALENDAR_ID

# WhatsApp number (optional) - shows WhatsApp button in sticky CTA if set
# Format: country code + number, no spaces or dashes (e.g. 13028935594)
VITE_UCSG_WHATSAPP_NUMBER=